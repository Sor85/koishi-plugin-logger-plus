{
  "name": "koishi-plugin-logger-plus",
  "description": "增强版 Koishi 控制台日志插件，支持过滤日志、自动暂停追踪。",
  "version": "0.0.11",
  "type": "commonjs",
  "packageManager": "yarn@4.15.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "src"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sor85/koishi-plugin-logger-plus.git"
  },
  "bugs": {
    "url": "https://github.com/Sor85/koishi-plugin-logger-plus/issues"
  },
  "homepage": "https://github.com/Sor85/koishi-plugin-logger-plus#readme",
  "scripts": {
    "clean": "shx rm -rf lib dist *.tsbuildinfo client/*.tsbuildinfo",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build": "yarn build:server && yarn build:client",
    "build:types": "tsc -p tsconfig.json",
    "build:server": "yarn build:types && tsup src/index.ts --format cjs --sourcemap --out-dir lib --clean false",
    "build:client": "vite build --config vite.config.mts",
    "lint": "eslint src client --ext .ts,.vue",
    "prepublishOnly": "yarn clean && yarn build"
  },
  "keywords": [
    "bot",
    "chatbot",
    "koishi",
    "plugin",
    "logs",
    "logger"
  ],
  "koishi": {
    "public": [
      "dist"
    ],
    "description": "增强版 Koishi 控制台日志插件，支持过滤、自动追踪和复制",
    "service": {
      "optional": [
        "console"
      ]
    }
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "koishi": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    }
  },
  "dependencies": {
    "@koishijs/console": "^5.30.11"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/core": "^4.18.11",
    "@koishijs/loader": "^4.6.0",
    "@koishijs/plugin-config": "^2.8.6",
    "@koishijs/plugin-console": "^5.30.11",
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^5.1.4",
    "ansi_up": "^5.2.1",
    "eslint": "^8.57.0",
    "koishi": "^4.18.11",
    "reggol": "^1.7.1",
    "sass": "^1.82.0",
    "shx": "^0.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "unocss": "^0.65.1",
    "vite": "^5.4.10",
    "vue": "^3.5.12"
  }
}
