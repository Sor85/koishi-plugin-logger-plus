{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "jsx": "preserve",
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "client",
    "src/**/*.d.ts",
    "env.d.ts"
  ]
}
